{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "STUTTGART-THINGS DAGGER MODULE PINS IN THE INLINE FULL-PATH FORM (github.com/stuttgart-things/dagger/<mod>@vX.Y.Z), WHICH NAMES ITS REPO ITSELF. INPUT DEFAULTS ARE ANNOTATED INSTEAD, SEE THE NEXT MANAGER",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "github\\.com/stuttgart-things/dagger/[a-z-]+@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "stuttgart-things/dagger",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "STUTTGART-THINGS MODULE PINS IN INPUT DEFAULTS AND with: VALUES, EACH MARKED WITH A '# renovate: datasource=github-releases depName=stuttgart-things/<dagger|blueprints>' LINE DIRECTLY ABOVE. THE INPUT NAME DOES NOT SAY WHICH REPO A PIN BELONGS TO: dagger-module-version AND argocd-module-version POINT AT BLUEPRINTS IN SOME WORKFLOWS AND AT DAGGER IN OTHERS, AND MOST *-module-version INPUTS WERE NOT WATCHED AT ALL (#201)",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>stuttgart-things/(?:dagger|blueprints))\\n[ \\t]+[A-Za-z_-]+:[ \\t]*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "DAGGER CLI PIN, PASSED TO dagger/dagger-for-github",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "dagger-version:[ \\t]*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "dagger-version:\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+default:[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "FLUX OPERATOR VERSION. LIVED IN FOUR PLACES ACROSS THREE REPOS AND ALL FOUR DISAGREED",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "operator-version:[ \\t]*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)",
        "operator-version:\\n(?:[ \\t]{8,}[^\\n]*\\n)*?[ \\t]{8,}default:[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "depNameTemplate": "controlplaneio-fluxcd/flux-operator",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "CONTAINER IMAGE DEFAULTS IN WORKFLOW INPUTS, MARKED WITH A renovate: KOMMENTAR",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n[ \\t]+default:[ \\t]*['\"]?[^'\"\\s:]+:(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    }
  ]
}
